APP_NAME="Clínica Sorriso e Vida"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_PORT=8001
APP_TIMEZONE=America/Boa_Vista

# dev local | prod em homologação/produção — o instalador de homologação força prod
APP_BUILD_TARGET=dev
# UID/GID do usuário do host (bind mounts sem problema de permissão)
DOCKER_UID=1000
DOCKER_GID=1000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: container "postgres" (docker-compose.local.yml)
# Servidor: apontar para o banco do servidor
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clinica_sorriso_vida
DB_USERNAME=clinica_sorriso_vida
DB_PASSWORD=secret
FORWARD_DB_PORT=5433

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_PORT=8081
EVOLUTION_INSTANCE=clinica-sorriso-e-vida
# Token que a rota de webhook exige (defina um valor forte em produção)
EVOLUTION_WEBHOOK_TOKEN=
# Homologação: vazio = bot responde a qualquer número (produção).
# Preenchido = só responde a esses números (formato do WhatsApp, sem o 9º dígito em linhas antigas)
EVOLUTION_ALLOWED_NUMBERS=

# Dados da clínica
CLINIC_NAME="Clínica Sorriso e Vida"
CLINIC_ADDRESS=""
CLINIC_PHONE=""
BOOKING_MINIMUM_NOTICE_HOURS=2
BOOKING_MAX_DAYS_AHEAD=90
WHATSAPP_SESSION_TIMEOUT_MINUTES=30

ADMIN_SEED_EMAIL=admin@sorrisoevida.com.br
ADMIN_SEED_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"
